// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider = "postgresql"
  provider     = "mysql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
  @@index([createdById])
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]
  posts            Post[]
  courses          Course[]         @relation("CreatedCourses")
  contents         Content[]        @relation("CreatedContents")
  contentsVariants ContentVariant[] @relation("CreatedContentsVariants")
  managedCourses   Course[]         @relation("ManagedCourses")
  joinedCourses    Course[]         @relation("JoinedCourses")
  subscriptions    Subscription[]   @relation("Subscriptions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ContentType {
  LESSON
  OVERVIEW
  ASSIGNMENT
}

model Content {
  id          String @id @default(cuid())
  contentCode String

  type        ContentType
  title       String
  description String?
  slt         String?
  contentHtml String?     @db.Text
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  moduleId String
  module   Module @relation("ModuleContents", fields: [moduleId], references: [id])

  variants ContentVariant[] @relation("ContentsVariants")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("CreatedContents", fields: [createdById], references: [id])
  createdById String

  @@unique([moduleId, contentCode])
  @@index([createdById])
  @@index([moduleId])
  @@index([id])
}

model ContentVariant {
  id          String @id @default(cuid())
  variantCode String

  title       String
  description String?
  slt         String?
  imageUrl    String?
  videoUrl    String?
  contentHtml String?  @db.Text
  contentJson Json?
  live        Boolean?

  contentId String
  content   Content @relation("ContentsVariants", fields: [contentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation("CreatedContentsVariants", fields: [createdById], references: [id])
  createdById String

  @@index([createdById])
  @@index([contentId])
  @@index([id])
}

model Module {
  id         String @id @default(cuid())
  moduleCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId String
  course   Course          @relation("CourseModules", fields: [courseId], references: [id])
  contents Content[]       @relation("ModuleContents")
  variants ModuleVariant[] @relation("ModuleVariants")

  @@unique([courseId, moduleCode])
  @@index([courseId])
  @@index([id])
}

model ModuleVariant {
  id String @id @default(cuid())

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  moduleId        String
  module          Module        @relation("ModuleVariants", fields: [moduleId], references: [id])
  courseVariantId String
  courseVariant   CourseVariant @relation("ModuleVariantsCourseVariant", fields: [courseVariantId], references: [id])

  @@index([courseVariantId])
  @@index([moduleId])
  @@index([id])
}

model Course {
  id         String @id @default(cuid())
  courseCode String

  title       String
  description String?
  category    String?
  imageUrl    String?
  videoUrl    String?

  modules         Module[]                @relation("CourseModules")
  managers        User[]                  @relation("ManagedCourses")
  joinedUsers     User[]                  @relation("JoinedCourses")
  variants        CourseVariant[]         @relation("CourseVariants")
  onchainInstance CourseOnChainInstance[] @relation("CourseInstance")

  createdBy   User   @relation("CreatedCourses", fields: [createdById], references: [id])
  createdById String

  @@unique([courseCode])
  @@index([createdById])
  @@index([id])
}

model CourseVariant {
  id          String @id @default(cuid())
  variantCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId       String
  course         Course          @relation("CourseVariants", fields: [courseId], references: [id])
  moduleVariants ModuleVariant[] @relation("ModuleVariantsCourseVariant")

  @@index([courseId])
  @@index([id])
}

model Subscription {
  id String @id @default(cuid())

  createdAt   DateTime @default(now())
  createdBy   User     @relation("Subscriptions", fields: [createdById], references: [id])
  createdById String

  @@index([createdById])
}

model CourseOnChainInstance {
  id                String @id @default(cuid())
  onchainInstanceId String @unique

  courseRefAddress  String?
  assignmentAddress String?
  creatorCS         String?
  facilitatorCS     String?
  learnerCS         String?
  courseRefUTxO     String?
  assignmentRefUTxO String?

  withCourse Course @relation("CourseInstance", fields: [courseId], references: [id])
  courseId   String

  @@index([courseId])
}
