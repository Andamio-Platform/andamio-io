// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  // provider     = "mysql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
  @@index([createdById])
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String?        @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  courses        Course[]       @relation("CreatedCourses")
  lessons        Lesson[]       @relation("CreatedLessons")
  // contents         Content[]        @relation("CreatedContents")
  // contentsVariants ContentVariant[] @relation("CreatedContentsVariants")
  managedCourses Course[]       @relation("CourseManagers")
  joinedCourses  Course[]       @relation("CourseLearners")
  subscriptions  Subscription[] @relation("Subscriptions")
  // Lesson         Lesson[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SLT {
  id      String @id @default(cuid())
  sltId   String
  sltText String

  moduleId String
  module   Module @relation("ModuleSLTs", fields: [moduleId], references: [id])

  assignmentId String
  assignment   Assignment @relation("AssignmentSLTs", fields: [assignmentId], references: [id])

  lesson Lesson?

  @@index([moduleId])
  @@index([assignmentId])
  @@index([id])
}

model Module {
  id         String @id @default(cuid())
  moduleCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId String
  course   Course @relation("CourseModules", fields: [courseId], references: [id])

  lessons Lesson[] @relation("ModuleLessons")

  assignment Assignment?

  variants ModuleVariant[] @relation("ModuleVariants")
  slts     SLT[]           @relation("ModuleSLTs")

  @@unique([courseId, moduleCode])
  @@index([courseId])
  @@index([id])
}

model ModuleVariant {
  id String @id @default(cuid())

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  moduleId        String
  module          Module        @relation("ModuleVariants", fields: [moduleId], references: [id])
  courseVariantId String
  courseVariant   CourseVariant @relation("ModuleVariantsCourseVariant", fields: [courseVariantId], references: [id])

  @@index([courseVariantId])
  @@index([moduleId])
  @@index([id])
}

model Course {
  id         String @id @default(cuid())
  courseCode String

  title       String
  description String?
  category    String?
  imageUrl    String?
  videoUrl    String?

  modules         Module[]                @relation("CourseModules")
  managers        User[]                  @relation("CourseManagers")
  joinedUsers     User[]                  @relation("CourseLearners")
  variants        CourseVariant[]         @relation("CourseVariants")
  onchainInstance CourseOnChainInstance[] @relation("CourseInstance")

  createdBy   User   @relation("CreatedCourses", fields: [createdById], references: [id])
  createdById String

  @@unique([courseCode])
  @@index([createdById])
  @@index([id])
}

model CourseVariant {
  id          String @id @default(cuid())
  variantCode String

  title       String
  description String?
  imageUrl    String?
  videoUrl    String?

  courseId       String
  course         Course          @relation("CourseVariants", fields: [courseId], references: [id])
  moduleVariants ModuleVariant[] @relation("ModuleVariantsCourseVariant")
  // contentVariants ContentVariant[] @relation("ContentVariantsCourseVariant")

  @@index([courseId])
  @@index([id])
}

model Subscription {
  id String @id @default(cuid())

  createdAt   DateTime @default(now())
  createdBy   User     @relation("Subscriptions", fields: [createdById], references: [id])
  createdById String

  @@index([createdById])
}

enum Network {
  PREPROD
  MAINNET
  SANCHONET
}

model CourseOnChainInstance {
  id                String @id @default(cuid())
  onchainInstanceId String @unique

  network              Network @default(PREPROD)
  courseRefAddress     String?
  assignmentAddress    String?
  creatorCS            String?
  facilitatorCS        String?
  learnerCS            String?
  moduleCS             String?
  courseRefUTxO        String?
  assignmentRefUTxO    String?
  moduleMintingRefUTxO String?

  withCourse Course @relation("CourseInstance", fields: [courseId], references: [id])
  courseId   String

  @@index([courseId])
}

model Lesson {
  id         String @id @default(cuid())
  lessonCode String

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  sltID String
  slt   SLT    @relation(fields: [sltID], references: [id])

  moduleId String
  module   Module @relation("ModuleLessons", fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("CreatedLessons", fields: [createdById], references: [id])
  createdById String
  // User        User?    @relation(fields: [userId], references: [id])
  userId      String?

  @@unique([moduleId, lessonCode])
  @@unique([sltID])
  @@index([createdById])
  @@index([moduleId])
  @@index([sltID])
  @@index([id])
}

model Assignment {
  id             String @id @default(cuid())
  assignmentCode String

  title       String
  description String?
  contentJson Json?
  imageUrl    String?
  videoUrl    String?
  live        Boolean?

  sltID String
  slts  SLT[]  @relation("AssignmentSLTs")

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])

  // variants ContentVariant[] @relation("ContentsVariants")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // createdBy   User     @relation("CreatedLessons", fields: [createdById], references: [id])
  createdById String
  // User        User?    @relation(fields: [userId], references: [id])
  userId      String?

  @@unique([moduleId, assignmentCode])
  @@unique([sltID])
  @@unique([moduleId])
  @@index([createdById])
  @@index([moduleId])
  @@index([sltID])
  @@index([id])
}

